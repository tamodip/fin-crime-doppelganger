#!/bin/sh
# Generate the development predictions and start the read-only local viewer.
DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "$DIR/.." && pwd)"
DATA="${1:-$ROOT/dev}"
OUTPUT="${2:-$ROOT/output/dev.jsonl}"
PORT="${3:-8765}"
"$DIR/run" "$DATA" "$OUTPUT" || exit $?
exec python3 "$DIR/ui_server.py" --data "$DATA" --output "$OUTPUT" --port "$PORT"
